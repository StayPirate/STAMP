{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/conventions.md",
    "docs/architecture.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "spec": {
      "description": "Writes and maintains feature specifications and declarative project configuration. Cannot modify implementation code.",
      "model": "github-copilot/claude-opus-4.6",
      "mode": "primary",
      "color": "warning",
      "prompt": "{file:./.opencode/prompts/spec.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "docs/**": "allow",
          "AGENTS.md": "allow",
          ".opencode/**": "allow",
          "opencode.json": "allow"
        },
        "bash": "allow"
      }
    },
    "code": {
      "description": "Implements features from specifications. Signals unresolved behavioral or contract gaps while choosing compliant internal technical mechanisms.",
      "model": "github-copilot/claude-sonnet-5",
      "mode": "primary",
      "color": "error",
      "prompt": "{file:./.opencode/prompts/code.md}",
      "permission": {
        "edit": {
          "*": "allow",
          "docs/**": "ask"
        },
        "bash": "allow"
      }
    }
  }
}
